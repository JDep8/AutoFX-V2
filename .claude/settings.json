{
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git branch:*)",
      "Bash(gh repo view:*)",
      "Bash(gh api repos/JDep8/AutoFX:*)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/*.rdp)",
      "Read(**/.pgpass)",
      "Read(**/pgpass.conf)"
    ]
  },
  "enabledPlugins": {
    "product-management@knowledge-work-plugins": true,
    "claude-md-management@claude-plugins-official": true,
    "session-report@claude-plugins-official": true
  }
}
