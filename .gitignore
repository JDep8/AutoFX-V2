# Secrets and credentials — never committed, in any form
.env
.env.*
*.pem
*.key
*.pfx
*.p12
*.rdp
*credentials*
*secret*
*token*
# …but never ignore the security policy document itself
!.claude/rules/security-and-secrets.md
.pgpass
pgpass.conf

# Local-only Claude settings (committed settings live in .claude/settings.json)
.claude/settings.local.json

# Local databases, generated/private datasets, caches
*.sqlite
*.db
data/
datasets/
__pycache__/
.cache/

# OS / editor noise
Thumbs.db
Desktop.ini
.DS_Store
*.swp
.vscode/
.idea/

# Local scratch (never part of the planning corpus)
scratch/
tmp/
